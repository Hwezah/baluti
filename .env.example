# All variables are optional. Without them the site builds and runs normally;
# Clerk auth is simply switched off. Copy to .env.local for local development.

# Clerk: set BOTH keys (dashboard.clerk.com → API Keys) to turn auth on.
# On Vercel, add them for every environment you deploy (Production AND Preview)
# and redeploy: NEXT_PUBLIC_ values are baked in at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Canonical site URL for metadata and share links. On Vercel it defaults to
# the project's production domain.
NEXT_PUBLIC_SITE_URL=

# Admin panel (/admin) publishing. With all three set, "Save to site" commits
# the client's text to src/content/site-text.json and Vercel redeploys.
# GITHUB_TOKEN needs write access to this repository's contents.
GITHUB_TOKEN=
ADMIN_PASSCODE=
# Optional on Vercel: taken from the deployment automatically.
GITHUB_REPO=
GITHUB_BRANCH=
